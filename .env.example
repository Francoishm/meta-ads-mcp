# Meta Marketing API
# Generate at https://developers.facebook.com/tools/explorer/
# Required scopes: ads_management, ads_read, business_management, read_insights
META_ACCESS_TOKEN=EAA...your_long_lived_token_here

# Default ad account (can be overridden per call). Format: act_XXXXXXXXX
META_AD_ACCOUNT_ID=act_123456789

# Optional: API version (default v19.0)
META_API_VERSION=v19.0

# Optional: read-only mode (blocks all write tools)
META_READ_ONLY=false
